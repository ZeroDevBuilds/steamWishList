{
  "name": "steam-wishlist-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:client",
    "dev": "tsx watch src/server.ts",
    "dev:client": "esbuild public/app.ts --bundle --outfile=public/app.js --watch",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "esbuild public/app.ts --bundle --outfile=public/app.js",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
