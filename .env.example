# Your SteamID64 (public wishlist required). Find it via https://steamid.io/ using your profile URL.
STEAM_ID64=

# Steam Web API key (free) — https://steamcommunity.com/dev/apikey
# Recommended even though the wishlist endpoint may work without it.
STEAM_API_KEY=

# IsThereAnyDeal API key (free) — https://isthereanydeal.com/apps/my/ (register an app to get a key)
ITAD_API_KEY=

# Steam store country/region code used for pricing (affects currency + regional discounts)
COUNTRY_CODE=us

PORT=3000
HOST=127.0.0.1

# Cache TTLs, in seconds
CACHE_TTL_WISHLIST_SEC=21600
CACHE_TTL_STEAM_PRICE_SEC=3600
# Short negative-cache TTL for a *failed* Steam price fetch (e.g. Akamai 403) — keeps a retried
# page load from immediately re-hammering Steam for the same game, without treating the failure
# as a real "no price data" result for anywhere near the full CACHE_TTL_STEAM_PRICE_SEC.
CACHE_TTL_STEAM_PRICE_FAILURE_SEC=120
# Steam store metadata (name, header artwork) — near-static, so it can sit well above the price
# TTL; it only exists to keep the batched store-details calls small on a warm cache.
CACHE_TTL_STEAM_ITEM_SEC=604800
CACHE_TTL_ITAD_LOOKUP_SEC=2592000
CACHE_TTL_ITAD_PRICE_SEC=3600
# How long each game's fully-enriched data (price + ITAD deal/history) is reused before
# re-fetching, regardless of refresh clicks — only games past this age get new API calls.
CACHE_TTL_GAME_SEC=86400

# Debug only: caps how many wishlist games get price/ITAD enrichment (e.g. 5 for fast
# local testing). The full wishlist is still fetched/cached; leave unset for production.
DEBUG_GAME_LIMIT=

# ITAD enforces a window quota — 1000 requests per 5 minutes for a verified account — and asks
# clients not to sit at the ceiling, so the budget below is deliberately under it. A whole
# wishlist refresh is well within one window; ITAD_THROTTLE_MS is only a burst damper on top.
ITAD_MAX_REQUESTS_PER_WINDOW=800
ITAD_RATE_WINDOW_SEC=300
ITAD_THROTTLE_MS=50

# Minimum ms between Steam requests (shared by the batched price and store-details calls).
# Prices are batched ~150 appids per request, so even a large wishlist is only a handful of
# calls — raise this if you still see 429s from Steam's storefront API.
STEAM_PRICE_THROTTLE_MS=1000
