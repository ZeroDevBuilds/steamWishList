# Your SteamID64 (public wishlist required). Find it via https://steamid.io/ using your profile URL.
STEAM_ID64=

# Steam Web API key (free) — https://steamcommunity.com/dev/apikey
# Recommended even though the wishlist endpoint may work without it.
STEAM_API_KEY=

# IsThereAnyDeal API key (free) — https://isthereanydeal.com/apps/my/ (register an app to get a key)
ITAD_API_KEY=

# Steam store country/region code used for pricing (affects currency + regional discounts)
COUNTRY_CODE=us

PORT=3000
HOST=127.0.0.1

# Cache TTLs, in seconds
CACHE_TTL_WISHLIST_SEC=21600
CACHE_TTL_STEAM_PRICE_SEC=3600
CACHE_TTL_ITAD_LOOKUP_SEC=2592000
CACHE_TTL_ITAD_PRICE_SEC=3600
# How long each game's fully-enriched data (price + ITAD deal/history) is reused before
# re-fetching, regardless of refresh clicks — only games past this age get new API calls.
CACHE_TTL_GAME_SEC=86400

# Debug only: caps how many wishlist games get price/ITAD enrichment (e.g. 5 for fast
# local testing). The full wishlist is still fetched/cached; leave unset for production.
DEBUG_GAME_LIMIT=
